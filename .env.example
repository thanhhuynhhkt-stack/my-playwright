# Your application URL. Change this to the target environment domain.
BASE_URL=

# Hostname of the ADFS/federated identity server (used to detect the ADFS redirect during login).
# Example: your-adfs-server.example.com
ADFS_HOST=

# Which browser to run tests on. Leave empty to run all browsers.
# Options: chromium, firefox, webkit, edge
BROWSER=

# Set to true when running in CI/CD (enables retries, limits parallel workers)
CI=false

# Gmail address used as the company email in registration forms and as the OTP inbox.
# Must match the account authorised in the Gmail API OAuth setup.
TEST_COMPANY_EMAIL=

# Gmail API credentials — HTTPS-based OTP reader, works on any network.
# Follow the setup steps in helpers/gmail-otp.ts to obtain these values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
